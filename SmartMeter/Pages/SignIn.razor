@page "/"
@using SmartMeter.Models
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation

<h3>Sign In</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p class="text-danger">@ErrorMessage</p>
}

<div>
    <label>Email:</label>
    <input type="email" @bind="Email" class="form-control" />
</div>
<div>
    <label>Password:</label>
    <input type="password" @bind="Password" class="form-control" />
</div>
<button class="btn btn-primary mt-2" @onclick="LoginUser">Login</button>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ErrorMessage { get; set; } = "";

    private async Task LoginUser()
    {
        try
        {
            var session = await SupabaseClient.Auth.SignIn(Email, Password);
            if (session != null)
            {
                Navigation.NavigateTo(Pages.WalletTransaction.ToRoutePath());
            }
        }
        catch (Exception ex)
        {
            //TODO :: Handle response
            ErrorMessage = "Login failed: " + ex.Message;
        }
    }
}