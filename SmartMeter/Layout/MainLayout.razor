@inherits LayoutComponentBase

@code
{
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool ShouldShowNavbar => !NavigationManager.Uri.Contains("signin", StringComparison.OrdinalIgnoreCase);
}

<div class="page">

    @if (ShouldShowNavbar)
    {
        <div class="sidebar">
            <NavMenu/>
        </div>
    }

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>